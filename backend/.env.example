# Database
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Admin credentials (exactly two admins)
ADMIN_1_USERNAME="admin1"
ADMIN_1_PASSWORD="admin1pass"
ADMIN_2_USERNAME="admin2"
ADMIN_2_PASSWORD="admin2pass"

# API
PORT=3000
NODE_ENV=development
#TODO:
# CORS (comma-separated origins; leave unset to allow all origins — useful for ngrok)
# CORS_ORIGINS="http://localhost:5173,https://your-app.ngrok-free.app"

# Python generator service
PYTHON_GENERATOR_URL="http://localhost:8001"

# Local file storage (relative to apps/api working directory)
STORAGE_ROOT="../../storage"
